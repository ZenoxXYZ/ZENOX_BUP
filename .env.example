# Copy this file to .env before starting the local PostgreSQL service.
# Docker Compose reads .env; FastAPI, Alembic, and pytest use DATABASE_URL from
# the host shell environment and do not load .env automatically.
POSTGRES_USER=hadf
POSTGRES_PASSWORD=hadf_local_password
POSTGRES_DB=hadf_dev
POSTGRES_PORT=5432

# Keep this value aligned with the PostgreSQL values above when copying to .env.
DATABASE_URL=postgresql+psycopg://hadf:hadf_local_password@127.0.0.1:5432/hadf_dev

# Optional: set only when multiple clones or worktrees share one Docker host.
# COMPOSE_PROJECT_NAME=hadf_local
